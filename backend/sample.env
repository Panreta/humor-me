# Copy to backend/.env and fill in the keys. Never commit .env.
# uvicorn does not read it by itself:  .venv/Scripts/python -m uvicorn app.main:app --port 8000 --env-file .env
# Settings are named by the job each model does. Older names (LLM_MODEL, LLM_BASE_URL, ...) still work.

# --- Where jokes come from during a show -------------------------------------------------------------
# bank = the hand-written jokes (no key, no quota; tests use this)
# llm  = the joke writer and safety check below. A live room also needs app/blocklist.local.txt (gitignored).
JOKE_SOURCE=bank

# --- Joke writer: writes each bit's jokes during the show --------------------------------------------
# gemini (any OpenAI-compatible endpoint at GEMINI_BASE_URL) or anthropic (Claude, official SDK).
# Still Gemini Flash-Lite (free tier: a 503 sends the bit to the bank) until Exp 24 picks the writer.
# Exp 24 candidates (D-96, D-97): claude-haiku-5-5 and bonsai-2:4b (local, fits the GPU beside Kokoro);
# mimo-v2.6:9b and gemma4:12b run as references only. On Claude: JOKE_WRITER_PROVIDER=anthropic, model claude-haiku-5-5.
JOKE_WRITER_PROVIDER=gemini
JOKE_WRITER_MODEL=gemini-flash-lite-latest

# --- Safety check: judges every line before the robot says it ----------------------------------------
# Claude Haiku 5.5 with thinking off (D-100): Gemini's free tier returns 503s in an outage, and a failed check
# sends the bit to the bank. Needs ANTHROPIC_API_KEY; about $0.003 a show. Gemini still works: provider gemini.
SAFETY_CHECK_PROVIDER=anthropic
SAFETY_CHECK_MODEL=claude-haiku-5-5
SAFETY_CHECK_THINKING=off

# --- Offline transcript pipeline (S4 bits, S5 annotation): quality over speed ------------------------
TRANSCRIPT_PIPELINE_MODEL=gemini-flash-latest

# --- Keys and endpoints ------------------------------------------------------------------------------
# Gemini's OpenAI-compatible endpoint (free tier). Measured 2026-10-21 (scripts/latency_probe.py):
#   gemini-flash-lite-latest TTFT ~0.6 s; gemini-flash-latest TTFT 18-38 s (thinking model).
# Other OpenAI-compatible endpoints work here too: Groq https://api.groq.com/openai/v1,
# Ollama http://localhost:11434/v1 (no key). List what your key can use: GET {GEMINI_BASE_URL}/models.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
# Claude (paid; platform.claude.com). The SDK reads it by this exact name.
ANTHROPIC_API_KEY=

# --- Local models for Exp 24 (Ollama, no key) --------------------------------------------------------
# Start the server with $env:OLLAMA_CONTEXT_LENGTH=8192; ollama serve  (quit the tray app first, it ignores this).
# Uncomment only if your server or tags differ from the defaults (`ollama list`).
# OLLAMA_URL=http://127.0.0.1:11434/v1
# BONSAI_OLLAMA_TAG=bonsai-2:4b
# MIMO_OLLAMA_TAG=mimo-v2.6:9b
# GEMMA_OLLAMA_TAG=gemma4:12b
