# Copy to backend/.env and fill in the keys. Never commit .env.
# uvicorn does not read it by itself:  .venv/Scripts/python -m uvicorn app.main:app --port 8000 --env-file .env
# Settings are named by the job each model does. Older names (LLM_MODEL, LLM_BASE_URL, ...) still work.

# --- Where jokes come from during a show -------------------------------------------------------------
# bank = the hand-written jokes (no key, no quota; tests use this)
# llm  = the joke writer and safety check below. A live room also needs app/blocklist.local.txt (gitignored).
JOKE_SOURCE=bank

# --- Joke writer: writes each bit's jokes during the show --------------------------------------------
# ollama (a model on this laptop), anthropic (Claude, official SDK) or gemini (any OpenAI-compatible endpoint at
# GEMINI_BASE_URL). bonsai-2:4b won Exp 24 (D-107): free, fits the GPU beside Kokoro, and it is the model we train.
# Start Ollama first (Keys and endpoints, below); each show loads the model before it starts.
# Claude Haiku was funnier but not clearly (D-107); to use it: JOKE_WRITER_PROVIDER=anthropic, model claude-haiku-5-5.
JOKE_WRITER_PROVIDER=ollama
JOKE_WRITER_MODEL=bonsai-2:4b

# --- Safety check: judges every line before the robot says it ----------------------------------------
# Claude Haiku 5.5 with thinking off (D-100): Gemini's free tier returns 503s in an outage, and a failed check
# sends the bit to the bank. Needs ANTHROPIC_API_KEY; about $0.003 a show. Gemini still works: provider gemini.
SAFETY_CHECK_PROVIDER=anthropic
SAFETY_CHECK_MODEL=claude-haiku-5-5
SAFETY_CHECK_THINKING=off

# --- Bridge lines: what plays while the next bit is written -----------------------------------------
# 1 (default) = a cached line is skipped when any show logged on this laptop already played it (D-112). With one
# listener the cached pool is then empty and the 10 filler lines cover every wait. Set 0 for a new audience (a demo),
# where replaying the best-received lines is the point.
BRIDGE_SKIP_HEARD=1

# --- Next-bit guess (D-115) ---------------------------------------------------------------------------------------
# 1 (default) = after joke 3 of a bit the show guesses the next bit's mode and writes it while jokes 4 and 5 play, so
# the next bit is often ready when the bit ends (Exp 31: the guess matches the director's pick about 7 times in 10).
# A wrong guess is thrown away and costs one extra local writer call and one safety prefetch. The director's choice and
# rewards are the same either way. Set 0 to turn it off.
PREDICT_NEXT_BIT=1

# --- Tonight's context (D-119) ------------------------------------------------------------------------------------
# 0 (default) = the writer gets no news. 1 = the operator screen fetches the S&P 500's last move (FRED) and today's top
# headlines (Google News RSS), turns the headlines into nameless one-sentence gists with the safety-check model, drops
# death, disaster, crime and war, and lets you approve gists (and type at most one line) before the show. Approved items
# go to the writer as background; bits 2 and 6 take a headline gist as their topic. Needs ANTHROPIC_API_KEY (the safety
# check's model). Off until Exp 35 passes (python -m sim.tonight fetch).
TONIGHT=0

# --- Offline transcript pipeline (S4 bits, S5 annotation): quality over speed ------------------------
TRANSCRIPT_PIPELINE_MODEL=gemini-flash-latest

# --- Keys and endpoints ------------------------------------------------------------------------------
# Gemini's OpenAI-compatible endpoint (free tier). Measured 2026-10-21 (scripts/latency_probe.py):
#   gemini-flash-lite-latest TTFT ~0.6 s; gemini-flash-latest TTFT 18-38 s (thinking model).
# Other OpenAI-compatible endpoints work here too: Groq https://api.groq.com/openai/v1,
# Ollama http://localhost:11434/v1 (no key). List what your key can use: GET {GEMINI_BASE_URL}/models.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
# Claude (paid; platform.claude.com). The SDK reads it by this exact name.
ANTHROPIC_API_KEY=

# --- Ollama, the local writer (no key) --------------------------------------------------------------
# Quit the Ollama tray app first (it restarts its own server and ignores these), then:
#   $env:OLLAMA_CONTEXT_LENGTH=8192; $env:OLLAMA_KEEP_ALIVE="-1"; $env:OLLAMA_NUM_PARALLEL=3; ollama serve
# NUM_PARALLEL 3: a bit is 3 calls at once (one thread each, D-110). With fewer slots they queue and the bit runs long.
# Each slot holds its own KV cache, so check the show still starts (it refuses unless the writer is 100% on the GPU).
# KEEP_ALIVE -1 keeps the writer loaded between shows instead of dropping it after 5 idle minutes. It keeps any other
# model loaded too: `ollama stop <name>` after Exp 24 or judge runs, or the show refuses to start (D-109).
# Uncomment only if your server or tags differ from the defaults (`ollama list`).
# OLLAMA_URL=http://127.0.0.1:11434/v1   (keep the /v1)
# Exp 24's harness reads these (sim/compare_generators.py):
# BONSAI_OLLAMA_TAG=bonsai-2:4b
# QWEN_OLLAMA_TAG=qwen3:4b-instruct
